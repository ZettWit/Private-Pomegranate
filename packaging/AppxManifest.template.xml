<?xml version="1.0" encoding="utf-8"?>
<!--
  Pomegranate MSIX manifest. tools/package-msix.ps1 fills in the {{…}} values.
  The Store replaces Identity Name/Publisher with the values it assigns at submission.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop4 desktop5 com rescap">

  <Identity Name="Pomegranate" Publisher="{{Publisher}}" Version="{{Version}}" ProcessorArchitecture="{{Arch}}" />

  <Properties>
    <DisplayName>Pomegranate</DisplayName>
    <PublisherDisplayName>Pomegranate contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Offline file converter: drag a file, hold a key, drop it on a wheel.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Pomegranate" Executable="Pomegranate.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Pomegranate"
        Description="Offline file converter"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Start when Windows starts (spec §10). -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="PomegranateStartup" Enabled="true" DisplayName="Pomegranate" />
        </uap5:Extension>

        <!-- "Open in Pomegranate" in the Windows 11 right-click menu (spec §12.3). -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="OpenInPomegranate" Clsid="21A5268D-A685-4143-A2E1-3F0C7C29FF02" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="OpenInPomegranate" Clsid="21A5268D-A685-4143-A2E1-3F0C7C29FF02" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Pomegranate context menu">
              <com:Class Id="21A5268D-A685-4143-A2E1-3F0C7C29FF02" Path="Pomegranate.Shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
