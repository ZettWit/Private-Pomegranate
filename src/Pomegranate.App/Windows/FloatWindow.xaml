<Window x:Class="Pomegranate.App.Windows.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Pomegranate.App.Infrastructure"
        Title="{l:Loc Float_Title}"
        Width="260" Height="320" MinWidth="200" MinHeight="140"
        ShowInTaskbar="False" Topmost="True" WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Loc Float_Hint}" TextWrapping="Wrap" Opacity="0.7" Margin="2,0,2,8" />
        <ListBox Grid.Row="1" x:Name="Items" SelectionMode="Extended"
                 PreviewMouseLeftButtonDown="OnItemMouseDown" PreviewMouseMove="OnItemMouseMove">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel ToolTip="{Binding Path}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{l:Loc Float_Remove}" Click="OnRemove" Margin="0,0,8,0" />
            <Button Content="{l:Loc Float_Clear}" Click="OnClear" />
        </StackPanel>
    </Grid>
</Window>
