<Window x:Class="Pomegranate.App.Windows.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Pomegranate.App.Infrastructure"
        Title="{l:Loc Progress_Title}"
        Width="360" SizeToContent="Height" MaxHeight="420"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStyle="ToolWindow">
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Jobs">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Opacity="0.7" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            </DockPanel>
                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,6,0,0"
                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="1" x:Name="CancelButton" Content="{l:Loc Progress_CancelAll}" HorizontalAlignment="Right"
                Margin="0,4,0,0" Click="OnCancel" />
    </Grid>
</Window>
